# Code::Blocks
*.cbp
*.depend
*.layout
# Dev-C++ / Bloodshed
*.dev
# ZinjaI
*.zpr
*.zinjai
# Visual Studio
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
.vs/
# VS Code / CLion / otros
.vscode/
.idea/
*.swp
*~

# --- Sistema operativo ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Respaldos y temporales ---
*.bak
*.tmp
*.orig
*.rej
